# Used by scripts/sync-rates-from-sanity.mjs and scripts/seed-sanity.mjs
# (not by the widget itself — the widget stays 100% static, see README)

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only needed by seed-sanity.mjs (write access). Create in Studio -> API -> Tokens.
SANITY_WRITE_TOKEN=

# Only needed if the dataset is private (sync-rates-from-sanity.mjs uses this
# for reads). Leave empty for a public dataset.
SANITY_READ_TOKEN=
