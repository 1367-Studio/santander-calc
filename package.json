{
  "name": "santander-calc",
  "version": "1.0.5",
  "description": "Santander revolving credit calculator widget — React component and vanilla JS loader",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "SantanderCalcButton.jsx",
    "loader.js",
    "README.md"
  ],
  "keywords": ["santander", "revolving", "credit", "calculator", "widget"],
  "license": "UNLICENSED",
  "scripts": {
    "sync:sanity": "node --env-file=.env scripts/sync-rates-from-sanity.mjs --target=prod",
    "sync:sanity:dry-run": "node --env-file=.env scripts/sync-rates-from-sanity.mjs --dry-run --target=prod",
    "sync:sanity:dev": "node --env-file=.env scripts/sync-rates-from-sanity.mjs --target=dev",
    "sync:sanity:dev:dry-run": "node --env-file=.env scripts/sync-rates-from-sanity.mjs --dry-run --target=dev",
    "seed:sanity": "node --env-file=.env scripts/seed-sanity.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@sanity/client": "^6.24.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1367-Studio/santander-calc.git"
  }
}
